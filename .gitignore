# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Tests and coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Build output
build/
dist/
*.dmg
assets/icon.iconset/

# Anything that could hold a credential or personal mail.
#
# The app writes these into ~/Library/Application Support and never into the
# checkout, but ICLOUD_TRIAGE_HOME can point anywhere, and a developer who
# points it at "." should not be one `git add .` away from publishing their
# own inbox.
# gitignore has no trailing comments: a "#" after a pattern is part of the
# pattern, and these two matched nothing at all until that was noticed.
#   settings.json     what is configured
#   corrections.json  every sender you have corrected, and where to
#   verdicts.json     a verdict per message, keyed by mailbox and UID
settings.json
corrections.json
verdicts.json
agent-status.json
Logs/
*.log
secrets*
*.pem
*.key
*.p12
*.cer
*.mobileprovision
.env
.env.*

# macOS
.DS_Store

# Universal2 build toolchain, fetched by tools/fetch_universal_python.sh
.toolchain/
.venv-universal/
BUILD_STAMP

# Anything the tuning tool writes out of a real inbox. It refuses to write
# inside the repository at all; this is the second lock on that door.
*-set.json
tuning/
inbox-*.json

# The two fixtures built from a real inbox. Everything in them has been
# anonymised, but anonymising a hundred real messages is not a thing you can
# prove finished - four passes each found something the previous one missed.
# They stay on the machine that made them; the hand-written sets ship.
tests/fixtures/private/

# Audio, video and images dropped in the working folder to test against.
# Somebody's music is somebody's copyright, and a reference photograph is
# not this project's to publish - and a ten megabyte MP3 reached the
# public repository this way once already. Ignored wherever it lands
# rather than only at the top, because the test material sits in tests/.
*.mp3
*.m4a
*.aac
*.wav
*.aif
*.aiff
*.flac
*.ogg
*.oga
*.opus
*.wma
*.mp4
*.mov
*.m4v
*.avi
*.mkv
# Reference pictures and screenshots taken while working.
*.jpg
*.jpeg
*.heic
*.heif
*.gif
*.bmp
*.tif
*.webp

# Documents. Somebody working on this drops a CV, an offer letter, a
# bank statement or a set of interview notes in the folder to test
# against, and none of those are things a public repository should ever
# be one "git add -A" away from publishing.
*.pdf
*.doc
*.docx
*.rtf
*.rtfd
*.odt
*.pages
*.key
*.numbers
*.xls
*.xlsx
*.ods
*.ppt
*.pptx
*.csv
*.tsv

# Mail, calendars and contacts, in every shape a mail client exports.
*.eml
*.emlx
*.mbox
*.mbx
*.msg
*.pst
*.ost
*.olm
*.ics
*.ifb
*.vcf
*.vcard

# Archives, which hide whatever is inside them from every check here.
*.zip
*.tar
*.tgz
*.gz
*.bz2
*.xz
*.7z
*.rar
*.sit
*.dmg
*.pkg

# Databases and caches somebody might copy in to look at.
*.sqlite
*.sqlite3
*.db
*.db-journal
*.realm

# Credentials and keys beyond the ones already listed above.
*.p8
*.pfx
*.jks
*.keystore
*.ppk
*.asc
*.gpg
*.kdbx
*.keychain
*.keychain-db
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
.netrc
.npmrc
.pypirc
.aws/
.ssh/
credentials.json
client_secret*.json
service-account*.json
token.json

# Crash reports and diagnostics, which carry paths, process names and
# sometimes the contents of memory.
*.ips
*.crash
*.diag
*.spin
*.hang

# Editor and system leftovers.
*.bak
*.old
*.orig
*.rej
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# The icons and the documentation's own pictures are committed
# deliberately, so they are excepted from the rules above. Kept last,
# because in gitignore the final matching rule is the one that counts.
!assets/**
!docs/assets/**
!docs/*.png
!data/*.gz
!requirements*.txt
!THIRD-PARTY-LICENSES.md
