#!/usr/bin/env bash
# One command for everything. Run ./dev with no arguments for the list.
#
# The virtualenv is created and kept up to date automatically, so a fresh
# clone needs exactly one command:  ./dev demo
set -euo pipefail
cd "$(dirname "$0")"

ROOT="$PWD"
VENV=".venv"
PY="$VENV/bin/python"
STAMP="$VENV/.deps-stamp"
APP="dist/Mail Manager.app"

B=$'\033[1m'; D=$'\033[2m'; G=$'\033[32m'; Y=$'\033[33m'; R=$'\033[31m'; N=$'\033[0m'
say()  { printf '%s==>%s %s\n' "$G" "$N" "$*" >&2; }
warn() { printf '%s==>%s %s\n' "$Y" "$N" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$R" "$N" "$*" >&2; exit 1; }

# --------------------------------------------------------------------------
# Environment (idempotent, and quiet when there is nothing to do)
# --------------------------------------------------------------------------
# An interpreter that runs on this machine's own architecture. An Intel
# Python on Apple silicon works, through Rosetta, until macOS starts warning
# that "Python includes a component that will not work with future versions
# of macOS" - which it now does, because Rosetta is being retired.
runs_natively() {
  local arch_here; arch_here="$(uname -m)"
  local slices; slices="$(lipo -archs "$1" 2>/dev/null)" || return 0
  [[ -z "$slices" ]] && return 0
  case "$arch_here" in
    arm64)  [[ "$slices" == *arm64* ]] ;;
    x86_64) [[ "$slices" == *x86_64* ]] ;;
    *)      return 0 ;;
  esac
}

find_python() {
  local candidate
  is_ok() { [[ -x "$1" ]] && "$1" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3,11) else 1)' >/dev/null 2>&1; }
  native_ok() { is_ok "$1" && runs_natively "$1"; }
  if [[ -n "${PYTHON_BIN:-}" ]]; then is_ok "$PYTHON_BIN" && { echo "$PYTHON_BIN"; return; }; fi

  # The universal2 build fetched for packaging, if it is already here. It is
  # native everywhere, which is exactly what is wanted.
  local toolchain="$ROOT/.toolchain/Python.framework/Versions/3.11/bin/python3.11"
  native_ok "$toolchain" && { echo "$toolchain"; return; }

  # Two passes: anything that runs natively first, then anything at all, so a
  # machine with only a foreign interpreter still works rather than refusing.
  local check
  for check in native_ok is_ok; do
    for candidate in python3.14 python3.13 python3.12 python3.11 python3; do
      command -v "$candidate" >/dev/null 2>&1 \
        && "$check" "$(command -v "$candidate")" && { command -v "$candidate"; return; }
    done
    for candidate in \
        /opt/homebrew/opt/python@3.1[1-9]/bin/python3.1[1-9] \
        /usr/local/opt/python@3.1[1-9]/bin/python3.1[1-9] \
        /Library/Frameworks/Python.framework/Versions/3.1[1-9]/bin/python3.1[1-9]; do
      "$check" "$candidate" && { echo "$candidate"; return; }
    done
  done
  return 1
}

ensure_venv() {
  if [[ ! -x "$PY" ]]; then
    local python_bin
    python_bin="$(find_python)" || die "Python 3.11+ not found. Try: brew install python@3.12"
    say "Creating $VENV with $python_bin ($("$python_bin" --version 2>&1))"
    "$python_bin" -m venv "$VENV"
    "$PY" -m pip install --upgrade pip --quiet
    rm -f "$STAMP"
  fi
  local newest="requirements.txt"
  [[ requirements-dev.txt -nt "$newest" ]] && newest="requirements-dev.txt"
  if [[ ! -f "$STAMP" || "$newest" -nt "$STAMP" ]]; then
    say "Installing dependencies (this happens once)"
    "$PY" -m pip install --quiet -r requirements-dev.txt
    touch "$STAMP"
  fi
}

ensure_icon() {
  [[ -f assets/icon.icns ]] && return
  say "Generating the app icon"
  QT_QPA_PLATFORM=offscreen "$PY" tools/make_icon.py >/dev/null
}

usage() {
  cat <<EOF
${B}iCloud Mail Job Triage — dev commands${N}

  ${B}./dev demo${N}              open the app filled with sample mail ${D}(no setup, no keys)${N}
  ${B}./dev run${N} [args]        open the app against your real inbox
  ${B}./dev dry${N}               scan for real, but folder moves are disabled
  ${B}./dev fake${N}              run the whole pipeline in the terminal, offline

  ${B}./dev creds${N}             store your iCloud + Anthropic credentials
  ${B}./dev config${N}            show settings and which credentials are present
  ${B}./dev check${N}             verify every runtime dependency resolves

  ${B}./dev scan${N} [args]       run the pipeline in the terminal against real mail
                          ${D}--hours 72  --limit 5  --full  --json  --prompt${N}
  ${B}./dev prompt${N} <uid>      print the exact prompt sent for one message

  ${B}./dev test${N} [args]       run the test suite  ${D}(args pass through to pytest)${N}
  ${B}./dev eval${N} [args]       score the offline sorter against the labelled set
  ${B}./dev cov${N}               test suite with a coverage report
  ${B}./dev watch${N}             re-run the tests whenever a file changes

  ${B}./dev build${N}             build "Mail Manager.app"
  ${B}./dev dmg${N}               build the drag-to-install disk image
  ${B}./dev app${N}               open the built app
  ${B}./dev install${N}           copy the built app to /Applications

  ${B}./dev logs${N}              follow the log file
  ${B}./dev shell${N}             python REPL with every module imported
  ${B}./dev reset${N}             delete saved settings ${D}(Keychain secrets are kept)${N}
  ${B}./dev clean${N}             remove build, dist and cache directories
  ${B}./dev nuke${N}              clean, and delete the virtualenv too

${D}Everything sets up its own environment on first use.${N}
EOF
}

# --------------------------------------------------------------------------
command="${1:-help}"
[[ $# -gt 0 ]] && shift || true

case "$command" in
  help|-h|--help|"")   usage ;;

  setup)               ensure_venv; say "Ready. Try: ./dev demo" ;;

  demo)                ensure_venv; exec "$PY" main.py --demo "$@" ;;
  run)                 ensure_venv; exec "$PY" main.py "$@" ;;
  dry)                 ensure_venv; exec "$PY" main.py --dry-run --verbose "$@" ;;

  creds|credentials)   ensure_venv; exec "$PY" main.py --set-credentials ;;
  config)              ensure_venv; exec "$PY" main.py --show-config ;;
  check|doctor)        ensure_venv; exec "$PY" main.py --self-test ;;

  scan)                ensure_venv; exec "$PY" tools/devscan.py "$@" ;;
  fake)                ensure_venv; exec "$PY" tools/devscan.py --fake "$@" ;;
  prompt)
    ensure_venv
    [[ $# -ge 1 ]] || die "usage: ./dev prompt <uid>   (add --fake for sample mail)"
    uid="$1"; shift
    exec "$PY" tools/devscan.py --prompt --uid "$uid" "$@" ;;

  test|t)              ensure_venv; QT_QPA_PLATFORM=offscreen exec "$PY" -m pytest "$@" ;;
  eval)                ensure_venv; QT_QPA_PLATFORM=offscreen exec "$PY" tools/evaluate.py "$@" ;;
  eval-llm)            ensure_venv; QT_QPA_PLATFORM=offscreen exec "$PY" tools/eval_llm.py "$@" ;;
  cov|coverage)
    ensure_venv
    QT_QPA_PLATFORM=offscreen "$PY" -m pytest --cov --cov-report=term-missing "$@"
    ;;
  watch)
    ensure_venv
    command -v fswatch >/dev/null 2>&1 || die "fswatch not installed. Try: brew install fswatch"
    say "Watching for changes — ctrl-c to stop"
    QT_QPA_PLATFORM=offscreen "$PY" -m pytest "$@" || true
    fswatch -o -e "\\.venv" -e "build" -e "dist" -e "__pycache__" . | while read -r _; do
      printf '\033[2J\033[H'
      QT_QPA_PLATFORM=offscreen "$PY" -m pytest "$@" || true
    done
    ;;

  build)               ensure_venv; ensure_icon; exec ./build_app.sh "$@" ;;
  dmg)                 ensure_venv; ensure_icon; exec ./build_dmg.sh "$@" ;;
  icon)                ensure_venv; QT_QPA_PLATFORM=offscreen exec "$PY" tools/make_icon.py ;;
  app|open)
    [[ -d "$APP" ]] || die "$APP not built yet. Run: ./dev build"
    exec open "$APP" ;;
  install)
    [[ -d "$APP" ]] || die "$APP not built yet. Run: ./dev build"
    say "Copying to /Applications"
    rm -rf "/Applications/Mail Manager.app"
    cp -R "$APP" /Applications/
    say "Installed. Launch it from Spotlight." ;;

  logs|log)
    log_file="$HOME/Library/Logs/iCloud Job Triage/triage.log"
    [[ -f "$log_file" ]] || die "No log yet at $log_file — run the app first."
    exec tail -f -n 40 "$log_file" ;;

  shell|repl)
    ensure_venv
    exec "$PY" -i -c "
import config, demo_data, html_utils, imap_engine, llm_engine, models, workers
from config import Settings, CredentialStore
from models import *
from demo_data import demo_items, demo_emails, DEMO_MESSAGES
items = demo_items()
print('Loaded: models, config, imap_engine, llm_engine, html_utils, demo_data, workers')
print(f'items -> {len(items)} sample TriageItem objects')
" ;;

  reset)               ensure_venv; exec "$PY" main.py --reset-settings --print-paths ;;

  clean)
    say "Removing build artifacts"
    rm -rf build dist .pytest_cache .coverage htmlcov assets/icon.iconset
    find . -name __pycache__ -type d -not -path "./$VENV/*" -exec rm -rf {} + 2>/dev/null || true
    say "Clean." ;;
  nuke)
    say "Removing build artifacts and the virtualenv"
    rm -rf build dist .pytest_cache .coverage htmlcov assets/icon.iconset "$VENV"
    find . -name __pycache__ -type d -exec rm -rf {} + 2>/dev/null || true
    say "Gone. Run ./dev demo to start over." ;;

  *)
    warn "Unknown command: $command"
    usage
    exit 2 ;;
esac
